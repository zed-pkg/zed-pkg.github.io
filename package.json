{
  "name": "zed-pkg-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity warning && npm run check:state",
    "check:state": "tsc --noEmit --allowJs --checkJs --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext public/account-state.js",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  }
}
