---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  canonicalPath: string;
}

const { title, description, eyebrow, heading, intro, canonicalPath } = Astro.props;
---

<Base {title} {description} {canonicalPath}>
  <main class="marketing-page">
    <header class="wrap page-hero">
      <a class="page-back" href="/">&larr; zed-pkg home</a>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{heading}</h1>
      <p class="page-lede">{intro}</p>
      <div class="page-actions">
        <slot name="actions" />
      </div>
    </header>
    <slot />
  </main>
</Base>

<style is:global>
  .marketing-page {
    min-height: 70vh;
  }

  .page-hero {
    padding-top: 78px;
    padding-bottom: 54px;
  }

  .page-back {
    display: block;
    width: fit-content;
    margin-bottom: 24px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: .78rem;
  }

  .page-hero h1 {
    max-width: 820px;
    margin-bottom: 18px;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .page-lede {
    max-width: 760px;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.18rem);
  }

  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .page-section > .wrap {
    display: grid;
    gap: 28px;
  }

  .page-section h2 {
    max-width: 760px;
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -.02em;
  }

  .page-section .section-intro {
    max-width: 760px;
    color: var(--muted);
  }

  .page-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .page-grid.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .page-card {
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--panel);
  }

  .page-card h3 {
    margin-bottom: 10px;
    font-size: 1.06rem;
  }

  .page-card p,
  .page-card li {
    color: var(--muted);
    font-size: .94rem;
  }

  .page-card ul,
  .prose-list {
    display: grid;
    gap: 9px;
    padding-left: 20px;
  }

  .page-card code,
  .page-section code {
    color: var(--blue);
    font-size: .88em;
  }

  .service-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .service-node {
    position: relative;
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
  }

  .service-node strong,
  .service-node code {
    display: block;
    overflow-wrap: anywhere;
  }

  .service-node strong {
    margin-bottom: 8px;
    color: var(--orange);
  }

  .service-node span {
    color: var(--muted);
    font-size: .86rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-bottom: 10px;
    padding: 3px 9px;
    border: 1px solid rgba(143, 211, 244, .35);
    border-radius: 999px;
    background: var(--blue-soft);
    color: var(--blue);
    font-family: var(--mono);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .05em;
  }

  .status-pill.progress {
    border-color: rgba(255, 122, 26, .38);
    background: var(--orange-soft);
    color: var(--orange);
  }

  .code-block {
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #020203;
    color: var(--text);
    font-family: var(--mono);
    font-size: .84rem;
    line-height: 1.7;
  }

  .callout {
    padding: 20px 22px;
    border: 1px solid rgba(143, 211, 244, .32);
    border-radius: 12px;
    background: var(--blue-soft);
  }

  .callout strong {
    display: block;
    margin-bottom: 6px;
    color: var(--blue);
  }

  .callout p {
    color: var(--muted);
  }

  .decision-table {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
  }

  .decision-table th,
  .decision-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .decision-table th {
    color: var(--text);
    font-size: .84rem;
  }

  .decision-table td {
    color: var(--muted);
    font-size: .88rem;
  }

  .decision-table tr:last-child td {
    border-bottom: 0;
  }

  @media (max-width: 860px) {
    .page-grid,
    .page-grid.three,
    .service-flow {
      grid-template-columns: 1fr;
    }

    .page-hero {
      padding-top: 52px;
    }

    .decision-table {
      display: block;
      overflow-x: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-back,
    .page-actions .btn {
      scroll-behavior: auto;
      transition: none;
    }
  }
</style>
