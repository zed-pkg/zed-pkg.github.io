---
import "../styles/global.css";
import "../styles/mobile-hardening.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "zed-pkg — install packages, not repositories",
  description = "zed-pkg is the universal package manager backed by the VCS hosts you already use: git, hg, jj and friends on GitHub, GitLab, Bitbucket, Codeberg, or your own servers. Lean, tag-verified artifacts; pnpm-style symlinks; container-first installs; self-hostable.",
} = Astro.props;

// Public content stays on zpkg.net. Authentication and account data terminate
// at the Rust MASH web server on the product origin.
const APP_ORIGIN = "https://app.zpkg.net";
const LOGIN_URL = `${APP_ORIGIN}/login`;
const SIGNUP_URL = `${APP_ORIGIN}/signup`;
const DASHBOARD_URL = `${APP_ORIGIN}/dashboard`;
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'none'",
  "object-src 'none'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "img-src 'self' data:",
  `connect-src 'self' ${APP_ORIGIN}`,
  "frame-src 'none'",
  "manifest-src 'self'",
  "form-action 'self'",
].join("; ");
---

<!doctype html>
<html lang="en" data-account-origin={APP_ORIGIN}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script type="module" src="/account-session.js"></script>
  </head>
  <body>
    <nav>
      <div class="wrap nav-inner">
        <a class="brand" href="/">
          <img src="/logo-mark.svg" alt="" />
          <span>zed<span class="accent">-pkg</span></span>
        </a>
        <div class="nav-links site-links" aria-label="Primary navigation">
          <a href="#how">How it works</a>
          <a href="#review">Release review</a>
          <a href="#containers">Containers</a>
          <a href="#pricing">Pricing</a>
          <a href="#repos">Repos</a>
          <a href="https://github.com/zed-pkg">GitHub</a>
        </div>
        <div class="account-links" role="group" aria-label="Account" aria-live="polite">
          <a
            class="account-link account-dashboard"
            href={APP_ORIGIN}
            data-account-primary
            data-login-href={LOGIN_URL}
            data-dashboard-href={DASHBOARD_URL}
          >
            Account
          </a>
          <a
            class="account-link account-signup"
            href={SIGNUP_URL}
            data-account-signup
          >
            Sign up
          </a>
        </div>
      </div>
    </nav>
    <slot />
    <footer>
      <div class="wrap footer-inner">
        <img src="/logo-mark.svg" alt="zed-pkg" />
        <span>(c) 2026 zed-pkg contributors - MIT - built in Rust</span>
        <div class="links">
          <a href={APP_ORIGIN}>app.zpkg.net</a>
          <a href="https://github.com/zed-pkg">github.com/zed-pkg</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-links {
    min-width: 0;
  }

  .account-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }

  .account-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 6px 10px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--muted);
    font-size: .84rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transition: color .15s ease, border-color .15s ease, background .15s ease, transform .15s ease;
  }

  .account-link:hover {
    color: var(--text);
  }

  .account-signup {
    border-color: var(--border);
    background: rgba(255, 255, 255, .02);
  }

  .account-signup:hover {
    border-color: rgba(143, 211, 244, .55);
    background: var(--blue-soft);
  }

  .account-dashboard {
    border-color: var(--orange);
    background: var(--orange);
    color: #0a0a0b;
    box-shadow: 0 8px 24px rgba(255, 122, 26, .2);
  }

  .account-dashboard:hover {
    color: #0a0a0b;
    background: #ff8f40;
    transform: translateY(-1px);
  }

  .account-link:focus-visible {
    outline: 3px solid rgba(143, 211, 244, .38);
    outline-offset: 2px;
  }

  [data-account-signup][hidden] {
    display: none;
  }

  @media (max-width: 1040px) {
    .site-links {
      display: none;
    }

    .account-links {
      margin-left: auto;
    }
  }

  @media (max-width: 390px) {
    .nav-inner {
      height: auto;
      min-height: 60px;
      padding-block: 9px;
      flex-wrap: wrap;
    }

    .account-links {
      width: 100%;
      justify-content: flex-end;
    }

    .account-link {
      min-height: 32px;
      padding-inline: 9px;
      font-size: .8rem;
    }
  }
</style>
